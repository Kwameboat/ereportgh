# Copy to .env and fill in values. Never commit .env.
#
# cPanel: if /api/health shows mysqlUser "root", the app is not reading this file.
# Set an absolute path in the Node.js app environment variables, e.g.:
#   ENV_FILE_PATH=/home/YOURUSER/ereportgh/server/.env

# --- Server ---
PORT=4000
# Listen address (0.0.0.0 = all interfaces; fine for local + Docker)
HOST=0.0.0.0
NODE_ENV=development
# Public URL of this API (no trailing slash) — used in PDF URLs
PUBLIC_BASE_URL=http://localhost:4000
# Behind nginx/Apache reverse proxy: TRUST_PROXY=1
TRUST_PROXY=0
# Production: comma-separated origins, e.g. https://results.school.edu
# Leave empty to allow any origin (OK for local dev only).
CORS_ORIGINS=

# Secret for Excel / VBA uploads (header: X-API-Key)
EXCEL_API_KEY=change-me-long-random-string
# JWT for admin sessions (production: 32+ random bytes, not the dev default)
JWT_SECRET=change-me-another-long-random-string
JWT_EXPIRES_IN=8h

# --- MySQL (your own server) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=school_results

# --- Docker (local) — use these if you run: docker compose up -d from project root ---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# If Windows MySQL80 already uses 3306, docker-compose maps MySQL to host port 3307 — match MYSQL_PORT here.
# MYSQL_USER=schoolresults
# MYSQL_PASSWORD=schoolresults
# MYSQL_DATABASE=school_results

# --- Paystack (https://paystack.com/docs) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_CALLBACK_URL=

# Fee for online report unlock (pesewas for GHS; e.g. 1000 = GH₵10.00)
PAYMENT_AMOUNT_SUBUNIT=1000
PAYMENT_CURRENCY=GHS

# --- Default admin (created on first migrate if no admins exist) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
